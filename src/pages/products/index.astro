---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/chrome/NavBar.astro';
import Footer from '../../components/chrome/Footer.astro';
import RelayLanding from '../../components/products/RelayLanding.astro';
import RawHtml from '../../components/RawHtml.astro';
import { webflow } from '../../data/site';
import bodyScriptsHome from '../../partials/body-scripts-home.html?raw';
import miriUiCss from '../../styles/miri-ui.css?raw';
import miriChatCss from '../../styles/miri-chat.css?raw';
import productsCss from '../../styles/products.css?raw';

const title = 'Miri Relay | Extend What’s Possible with Aspire';
const description =
  'Explore Miri Relay: Plant Library, Service Notifications, and Directory. Get more value from the Aspire data your team already maintains.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/products"
  bodyClass="body mk-page products-page"
  webflowPageId={webflow.pages.privacy}
>
  <Fragment slot="head">
    <style is:global set:html={miriUiCss}></style>
    <style is:global set:html={miriChatCss}></style>
    <style is:global set:html={productsCss}></style>
  </Fragment>
  <main class="main-wrapper">
    <NavBar variant="legal" />
    <RelayLanding />
    <Footer variant="legal" />
  </main>
  <Fragment slot="scripts">
    <RawHtml html={bodyScriptsHome} />
  </Fragment>
</BaseLayout>
