---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavBar from '../../components/chrome/NavBar.astro';
import Footer from '../../components/chrome/Footer.astro';
import JsonLdAspireLandscape from '../../components/seo/JsonLdAspireLandscape.astro';
import RawHtml from '../../components/RawHtml.astro';
import { cta } from '../../data/site';
import { calendlyPopupOnclick, syncPrimaryCalendlyUrl } from '../../utils/calendly';
import { rewriteAssetPaths } from '../../utils/rewriteAssetPaths';
import bodyScriptsHome from '../../partials/body-scripts-home.html?raw';
import aspireBody from '../../partials/aspire-landscape-landing-body.html?raw';
import miriUiCss from '../../styles/miri-ui.css?raw';
import aspireLandingCss from '../../styles/aspire-landing.css?raw';

const canonicalPath = '/aspire-consulting-for-landscape-companies';
const title = 'Aspire Consulting for Landscape Companies | Miri Consulting';
const description =
  'Miri helps US landscape companies improve Aspire setup, QuickBooks month-end close, job costing, estimating, workflows, reporting, and operations.';
const calendlyOnclick = calendlyPopupOnclick(cta.calendlyUrl);

const bodyHtml = syncPrimaryCalendlyUrl(
  rewriteAssetPaths(aspireBody)
    .replaceAll('__CALENDLY_URL__', cta.calendlyUrl)
    .replaceAll('__CALENDLY_ONCLICK__', calendlyPopupOnclick(cta.calendlyUrl)),
);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  bodyClass="body mk-page aspire-page"
>
  <Fragment slot="head">
    <JsonLdAspireLandscape canonicalPath={canonicalPath} />
    <style is:global set:html={miriUiCss}></style>
    <style is:global set:html={aspireLandingCss}></style>
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  </Fragment>
  <main class="main-wrapper">
    <NavBar variant="legal" />
    <header class="mk-hero mk-hero--center">
      <div class="mk-container">
        <div class="mk-hero__copy">
          <p class="mk-eyebrow">Aspire consulting</p>
          <h1 class="mk-h1">Aspire Consulting for Landscape Companies</h1>
          <p class="mk-lead">
            Miri helps US landscape companies get more value from Aspire by improving setup,
            accounting workflows, job costing, estimating, reporting, and day-to-day operations.
          </p>
          <div class="mk-btn-row">
            <a href={cta.calendlyUrl} class="mk-btn mk-btn--primary" onclick={calendlyOnclick}>
              Schedule a call
            </a>
            <a href="#services" class="mk-btn mk-btn--secondary">See how Miri helps</a>
          </div>
        </div>
      </div>
    </header>
    <RawHtml html={bodyHtml} />
    <Footer variant="legal" />
  </main>
  <Fragment slot="scripts">
    <RawHtml html={bodyScriptsHome} />
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
  </Fragment>
</BaseLayout>
