---
import { analytics, vendor } from '../../data/site';
import { rootPath } from '../../utils/rootPath';

interface Props {
  includeFinsweet?: boolean;
}

const { includeFinsweet = false } = Astro.props;
const gaId = analytics.gaMeasurementId;
const gtmId = analytics.gtmId;
const crispId = analytics.crispWebsiteId;
const clarityId = analytics.clarityProjectId;

// GA4 (gtag.js) loads directly from Google so hits go straight to
// google-analytics.com/g/collect. The Webflow export shipped a "first-party
// mode" tag (public/tracking/first-party) that monkey-patched XHR/sendBeacon
// to proxy every hit through a masked same-origin path (/haqt6.../). That path
// only resolved behind Webflow's server-side container and 405s on a static
// host, so the tag and its `google_tags_first_party` bootstrap were removed.
// The plain gtag('config', ...) below sets no transport_url, so GA4 collects
// directly.
//
// Consent: CookieYes runs in opt-in mode for every visitor. It blocks
// non-Google scripts such as Clarity itself, but for Google tags it only
// pushes `gtag('consent', 'update', ...)` — it never sets a default. Without
// the default below, GA4 and the Google Ads tags in the GTM container sent
// hits with no consent state (treated as granted) before the visitor chose.
---

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  // Global on purpose: inline `define:vars` scripts are wrapped in a function
  // scope, so a `function gtag` declared in one never reached `window`, and
  // `window.gtag(...)` calls elsewhere silently did nothing.
  window.gtag = function gtag() {
    window.dataLayer.push(arguments);
  };
  window.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    // CookieYes loads below GTM; give its stored-choice update time to land.
    wait_for_update: 500,
  });
  window.gtag('set', 'ads_data_redaction', true);
</script>
<script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
<script is:inline define:vars={{ gaId }}>
  const gtag = window.gtag;
  gtag('set', 'developer_id.dZGVlNj', true);
  gtag('set', 'developer_id.dYWYxNW', true);
  gtag('js', new Date());
  gtag('config', gaId);
</script>
<style is:inline>
  * {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -o-font-smoothing: antialiased;
  }
</style>
<script is:inline define:vars={{ crispId }}>
  window.$crisp = [];
  window.CRISP_WEBSITE_ID = crispId;

  function loadCrisp() {
    if (window.__miriCrispLoaded) return;
    window.__miriCrispLoaded = true;
    const d = document;
    const s = d.createElement('script');
    s.src = 'https://client.crisp.chat/l.js';
    s.async = 1;
    d.getElementsByTagName('head')[0].appendChild(s);
  }

  window.setTimeout(loadCrisp, 3000);
  window.addEventListener('scroll', loadCrisp, { once: true, passive: true });
</script>
<meta name="facebook-domain-verification" content={analytics.facebookDomainVerification} />
<script is:inline define:vars={{ gtmId }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    const f = d.getElementsByTagName(s)[0];
    const j = d.createElement(s);
    const dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', gtmId);
</script>
<script id="cookieyes" type="text/javascript" src={vendor.cookieYes} is:inline></script>
{includeFinsweet ? <script async src={rootPath(vendor.finsweetModal)} is:inline></script> : null}
<script is:inline define:vars={{ clarityId }}>
  function loadClarity() {
    if (window.__miriClarityLoaded) return;
    window.__miriClarityLoaded = true;

  (function (c, l, a, r, i, t, y) {
    c[a] = c[a] || function () {
      (c[a].q = c[a].q || []).push(arguments);
    };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i + '?ref=Webflow';
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', clarityId);
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(loadClarity);
  } else {
    window.setTimeout(loadClarity, 2000);
  }
</script>
<script is:inline>
  // Relay signup clicks, as a named event GA4 can mark as a key event. GA4's
  // automatic outbound-click tracking already records other external links;
  // it just can't single these out. The links open in a new tab, so the page
  // stays alive for the hit, and GA4 holds it to consent like any other.
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
    if (!link) return;
    const url = new URL(link.href, document.baseURI);
    if (url.hostname === 'relay.miri-consulting.com' && url.pathname.startsWith('/signup')) {
      window.gtag('event', 'relay_signup_click', { link_url: url.href, link_text: link.textContent.trim().slice(0, 100) });
    }
  });
</script>
