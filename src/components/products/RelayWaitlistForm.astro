---
import { relay } from '../../data/site';

const signInUrl = relay.signInUrl;
const signupUrl = relay.signupUrl;
---

<section id="early-access" class="mk-section mk-section--flush-top">
  <div class="mk-container">
    <div class="mk-cta">
      <div class="mk-cta__inner">
        <p class="mk-eyebrow">Early access</p>
        <h2 class="mk-h2">Request early access</h2>
        <p class="mk-lead">
          We’re onboarding a limited group to start. Nothing to sign and no card required — we’ll
          follow up to get your organization set up and walk you through pricing.
        </p>
        <div class="mk-btn-row">
          <a href={signupUrl} class="mk-btn mk-btn--primary" target="_blank" rel="noopener">
            Request access
          </a>
          <a href={signInUrl} class="mk-btn mk-btn--secondary" target="_blank" rel="noopener">
            Sign in
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
