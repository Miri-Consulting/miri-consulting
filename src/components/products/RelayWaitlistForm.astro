---
import { relay } from '../../data/site';

const signInUrl = relay.signInUrl;
const signupUrl = relay.signupUrl;
---

<section id="early-access" class="section_contact9 products-waitlist">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="text-align-center">
          <div class="margin-bottom margin-xxsmall">
            <h2 class="heading-style-h3">Request early access</h2>
          </div>
          <div class="w-layout-vflex margin-bottom margin-xsmall">
            <p class="text-size-medium">
            We’re onboarding a limited group of Miri customers. No pricing or commitment at this stage.
            </p>
          </div>
          <div class="button-group is-center">
            <a href={signupUrl} class="button-2 w-button" target="_blank" rel="noopener">Request access</a>
          </div>
          <p class="text-size-medium products-waitlist-signin">
            Already have access?
            <a href={signInUrl} target="_blank" rel="noopener">Sign in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
