---
import { relay } from '../../data/site';

const waitlistUrl = relay.waitlistFormUrl.trim();
const signInUrl = relay.signInUrl;
const hasDestination = waitlistUrl.length > 0;
---

<section id="early-access" class="section_contact9 products-waitlist">
  <div class="padding-global">
    <div class="container-small">
      <div class="padding-section-large">
        <div class="text-align-center">
          <div class="margin-bottom margin-xxsmall">
            <h2 class="heading-style-h3">Request early access</h2>
          </div>
          <div class="w-layout-vflex margin-bottom margin-xsmall">
            <p class="text-size-medium text-color-grey">
            We’re onboarding a limited group of Miri customers. No pricing or commitment at this stage.
            </p>
          </div>
          <div class="products-waitlist-form-wrap">
            <form
              id="relay-waitlist-form"
              class="products-waitlist-form"
              method="post"
              action={hasDestination ? waitlistUrl : undefined}
              data-waitlist-url={waitlistUrl}
              novalidate
            >
              <label for="relay-work-email" class="products-waitlist-label">Work email</label>
              <input
                id="relay-work-email"
                class="w-input products-waitlist-input"
                type="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                required
                placeholder="you@company.com"
              />
              <p id="relay-waitlist-error" class="products-waitlist-error" hidden></p>
              <button type="submit" class="button-2 w-button products-waitlist-submit">Request access</button>
            </form>
            <div id="relay-waitlist-success" class="products-waitlist-success" hidden>
              <p class="text-size-medium">
              You’re on the list. We’ll follow up with details and see if it’s a fit for your operation.
              </p>
            </div>
          </div>
          <p class="text-size-medium text-color-grey products-waitlist-signin">
            Already have access?
            <a href={signInUrl} target="_blank" rel="noopener">Sign in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("relay-waitlist-form");
  const success = document.getElementById("relay-waitlist-success");
  const errorEl = document.getElementById("relay-waitlist-error");
  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = form.elements.namedItem("email");
      const email = input instanceof HTMLInputElement ? input.value.trim() : "";
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (errorEl) {
        if (!valid) {
          errorEl.hidden = false;
          errorEl.textContent = "Enter a valid work email.";
          return;
        }
        errorEl.hidden = true;
        errorEl.textContent = "";
      }
      const dest = (form.dataset.waitlistUrl || "").trim();
      if (dest) {
        try {
          await fetch(dest, { method: "POST", body: new FormData(form), mode: "no-cors" });
        } catch {
          /* Destination is third-party; no-cors cannot surface a real error. */
        }
      }
      form.hidden = true;
      if (success) success.hidden = false;
    });
  }
</script>
