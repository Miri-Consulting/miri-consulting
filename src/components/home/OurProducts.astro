---
import { relay } from '../../data/site';
import { rootPath } from '../../utils/rootPath';

const productsHref = rootPath('/products');
const signupUrl = relay.signupUrl;
---

<section class="section_contact9">
  <div class="padding-global">
    <div class="container-medium">
      <div class="padding-section-medium">
        <div class="text-align-center">
          <div class="margin-bottom margin-xxsmall">
            <h2 class="heading-style-h2">Our Products</h2>
          </div>
          <p class="text-size-medium-smallspace text-color-grey">
            Relay turns your Aspire schedule into consolidated pre- and post-visit texts. Your team controls who gets notified, which services trigger a message, what it says, and when it goes out.
          </p>
          <div class="margin-top margin-medium">
            <div class="button-group is-center">
              <a href={signupUrl} class="button-2 w-button" target="_blank" rel="noopener">Request early access</a>
              <a href={productsHref} class="button-2 is-secondary w-inline-block">
                <div>Learn more about Relay</div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
